# Google Maps Platform API Key (same key works for Places, Geocoding, Street View)
GOOGLE_PLACES_API_KEY=your_google_maps_api_key_here

# Cache configuration
CACHE_DB_PATH=./planter_app/data/venue_cache.db
CACHE_TTL_DAYS=7

# Discovery defaults
DEFAULT_QUANTITY_TARGET=5000
DEFAULT_GRID_RADIUS_METERS=2000
STREET_VIEW_SEARCH_RADIUS_METERS=30

# Network
REQUEST_TIMEOUT=30

# Safety limits (to avoid unexpected API charges during development)
MAX_API_CALLS=100
RATE_LIMIT_DELAY_SECONDS=0.5

# Replicate API (optional — enables generative scene editing)
# Get token at https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=your_replicate_token_here

# Compositing mode switch:
#   "cv"         → deterministic OpenCV/PIL compositing (default, no GPU needed)
#   "generative" → Replicate FLUX editing (requires REPLICATE_API_TOKEN)
COMPOSITING_MODE=cv

# Replicate model for generative compositing.
# Available free-tier options:
#   black-forest-labs/flux-kontext-pro   ← default, image editing via prompt
#   black-forest-labs/flux-1.1-pro
#   black-forest-labs/flux-dev
#   google/imagen-4
#   ideogram-ai/ideogram-v3-turbo
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
